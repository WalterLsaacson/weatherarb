# Copy to repo root as .env and fill in secrets.
# Empty values fall back to code defaults. LIVE_ORDERS must be true for real orders.

PRIVATE_KEY=
CHAIN_ID=137
SIGNATURE_TYPE=3
FUNDER=
CLOB_HOST=https://clob.polymarket.com
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

LIVE_ORDERS=true
MAX_ORDER_USDC=5
MIN_NET_EDGE=0.0075
MAX_ASK=0.995
MAX_SLIPPAGE=0.003

# GTC limit buys on locked Yes/No. Target notional is LIMIT_ORDER_USDC;
# live posts use min(available collateral, LIMIT_ORDER_USDC) per order.
LIMIT_ORDERS=true
LIMIT_ORDER_USDC=5
LIMIT_ORDER_PRICE=0.99
# 0.001-tick books. 0.01-tick books stay on LIMIT_ORDER_PRICE.
LIMIT_ORDER_PRICE_001=0.995
LIMIT_ORDER_MIN_PRICE=0.01
LIMIT_ORDER_MAX_PRICE=0.99

# Diurnal FAK after the predicted window. Independent of LIVE_ORDERS.
# Yes buys the confirmed bucket. No buys every other bucket.
# DIURNAL_YES_ORDERS falls back to DIURNAL_ORDERS when unset.
# Notional cap is DIURNAL_ORDER_USDC per order, not MAX_ORDER_USDC.
# DIURNAL_MIN_PRICE is inclusive: 0.90 buys, anything lower does not.
DIURNAL_ORDERS=false
DIURNAL_YES_ORDERS=
DIURNAL_NO_ORDERS=false
DIURNAL_ORDER_USDC=5
DIURNAL_MIN_PRICE=0.90
# Compare event-day and previous-day whole-day Open-Meteo weather classes.
# A mismatch or fetch error blocks every diurnal order for that event day.
DIURNAL_FORECAST_GATE=false
FORECAST_CACHE_TTL_S=3600

# Synoptic / MesoWest token used for NOAA station timeseries
SYNOPTIC_API_TOKEN=

# Optional outbound proxy for weather/PM HTTP (direct by default).
# When direct is reset, requests fall back to WEATHER_PROXY_FALLBACK.
# Unset auto-uses http://127.0.0.1:1082 if that port is open. off disables it.
# WEATHER_PROXY=
# WEATHER_PROXY_FALLBACK=
# PM_PROXY=none
