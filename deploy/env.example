# Copy to repo root as .env and fill in secrets.
# Empty values fall back to code defaults. LIVE_ORDERS must be true for real orders.

PRIVATE_KEY=
CHAIN_ID=137
SIGNATURE_TYPE=3
FUNDER=
CLOB_HOST=https://clob.polymarket.com
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

LIVE_ORDERS=true
MAX_ORDER_USDC=5
MIN_NET_EDGE=0.0075
MAX_ASK=0.995
MAX_SLIPPAGE=0.003

# GTC limit buys on locked Yes/No. LIMIT_ORDER_USDC is the target notional
# (shares ≈ USDC / LIMIT_ORDER_PRICE, floored; must still cover exchange min_order).
LIMIT_ORDERS=true
LIMIT_ORDER_USDC=5
LIMIT_ORDER_PRICE=0.99
LIMIT_ORDER_MIN_PRICE=0.01
LIMIT_ORDER_MAX_PRICE=0.99

# Synoptic / MesoWest token used for NOAA station timeseries
SYNOPTIC_API_TOKEN=

# Optional outbound proxy for weather/PM HTTP (direct by default)
# WEATHER_PROXY=
# PM_PROXY=none
